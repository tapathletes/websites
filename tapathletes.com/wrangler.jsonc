// Cloudflare Workers static-assets site for tapathletes.com (replaces GitHub Pages and the planned Vercel project).
// No code runs: Cloudflare serves the files in this folder. `.assetsignore` keeps dev and build files off the site.
{
  "name": "tapathletes-com",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    // /foundations -> /foundations/ and /foundations/curriculum-guide -> curriculum-guide.html, as GitHub Pages did.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  // Live hostname. Attached as a Workers route on the proxied apex record (not a custom domain) — see
  // docs/runbooks/cloudflare-dns.md in tapathletes/tapos. Kept here so every deploy keeps it.
  // www.tapathletes.com is a Cloudflare redirect rule to the apex, not a route.
  "routes": [
    { "pattern": "tapathletes.com/*", "zone_name": "tapathletes.com" }
  ],
  "workers_dev": true,
  "preview_urls": false
}
